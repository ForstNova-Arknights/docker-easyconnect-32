# Sangfor's deb packages are fetched on demand (see local-deps/fetch.sh) and are
# deliberately never committed: they are large and they are Sangfor's property.
*.deb
/local-deps/*
!/local-deps/fetch.sh
!/local-deps/README.md

# Local build outputs
/build/
qemu-user/build/
*.tar.xz
*.tar.gz

# Native test emulators; only the cross-built ones are shipped
qemu-user/qemu-arm-amd64
qemu-user/qemu-x86_64-amd64
