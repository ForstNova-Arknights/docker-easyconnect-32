# Dockerfile.cli-armhf -- armhf (linux/arm/v7) build of the docker-easyconnect
# CLI image.
#
# Build with:
#   docker buildx build --platform linux/arm/v7 -f Dockerfile.cli-armhf \
#       -t hagb/docker-easyconnect:cli-armhf .
#
# Differences from the upstream Dockerfile.cli:
#   * The amd64 EasyConnect binaries are executed by a *patched* static
#     qemu-x86_64 built for armhf (see ./qemu-armhf/qemu-x86_64 and
#     ./qemu-armhf/BUILD.md).  The patch makes linux-user forward
#     getsockopt(fd, SOL_IP, SO_ORIGINAL_DST, ...) to the host kernel,
#     which the upstream emulator answers with -ENOPROTOOPT.
#   * Debian's qemu-user package is deliberately *not* installed: since
#     QEMU 10 it no longer ships 64-bit target emulators for 32-bit
#     hosts, so armhf has no qemu-x86_64 any more, and pulling the
#     trixie build in would drag trixie's libc into a bookworm image.
#   * Only bookworm is used as an apt source, and the EasyConnect payloads
#     are taken from ./local-deps (fetched once on the build host) so the
#     emulated build does not depend on flaky downloads.
FROM debian:bookworm-slim

# Plain http on purpose: debian:bookworm-slim carries no CA certificates yet,
# so an https apt source cannot be verified until ca-certificates is installed.
ARG BUILD_ENV=local \
    MIRROR_URL=http://mirrors.aliyun.com/debian/ \
    SECURITY_URL=http://mirrors.aliyun.com/debian-security/ \
    EC_HOST=amd64 \
    http_proxy https_proxy

COPY ["./build-scripts/get-echost-names.sh", "./build-scripts/mk-qemu-wrapper.sh", \
      "/tmp/build-scripts/"]
# Patched qemu-x86_64: static, armhf, QEMU 9.2.3 + SO_ORIGINAL_DST forwarding.
COPY ["./qemu-armhf/qemu-x86_64", "/usr/bin/qemu-x86_64"]
# EasyConnect packages (original URLs are recorded in local-deps/fetch.sh).
COPY ["./local-deps/", "/tmp/local-deps/"]

RUN chmod 0755 /usr/bin/qemu-x86_64 && \
    rm -f /etc/apt/sources.list && rm -rf /etc/apt/sources.list.d/* && \
    printf 'deb %s bookworm main\ndeb %s bookworm-updates main\ndeb %s bookworm-security main\n' \
        "${MIRROR_URL}" "${MIRROR_URL}" "${SECURITY_URL}" > /etc/apt/sources.list && \
    dpkg --add-architecture "${EC_HOST}" && \
    apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests iptables \
        dante-server busybox iproute2 tinyproxy-bin ca-certificates \
        "libc6:${EC_HOST}" "libstdc++6:${EC_HOST}" socat wget && \
    for command in ps kill killall; do ln -s "$(which busybox)" /usr/local/bin/"${command}" || exit 1 ; done && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r socks && useradd -r -g socks socks

RUN EC_DIR=/usr/share/sangfor/EasyConnect/resources && mkdir -p /tmp/work && cd /tmp/work && \
    dpkg -x /tmp/local-deps/easyconn_7.6.8.2-ubuntu_amd64.deb easyconn && \
    bash -c "mkdir -p ${EC_DIR}/{bin,lib64,shell,logs}/" && \
    bash -c "cp easyconn/${EC_DIR}/bin/{CSClient,easyconn,ECAgent,svpnservice,ca.crt,cert.crt} \
               /${EC_DIR}/bin/" && \
    bash -c "chmod +xs ${EC_DIR}/bin/{CSClient,ECAgent,svpnservice}" && \
    extra_bins=easyconn . /tmp/build-scripts/mk-qemu-wrapper.sh && \
    bash -c "cp easyconn/${EC_DIR}/lib64/lib{nspr4,nss3,nssutil3,plc4,plds4,smime3}.so \
               /${EC_DIR}/lib64/" && \
    cp easyconn/${EC_DIR}/shell/* \
               /${EC_DIR}/shell/ && \
    chmod +x ${EC_DIR}/shell/* && \
    ln -s ${EC_DIR}/bin/easyconn /usr/local/bin/ && \
    cp -r easyconn/${EC_DIR}/conf ${EC_DIR}/conf_7.6.8 && rm -rf /tmp/work && echo "EC_CLI" > /etc/vpn-type

RUN cd /tmp && mkdir -p /tmp/work && cd /tmp/work && \
    for ver in 7.6.3 7.6.7 ; do { \
        case "$ver" in \
          7.6.3) ec_deb=/tmp/local-deps/EasyConnect_x64.deb ;; \
          7.6.7) ec_deb=/tmp/local-deps/EasyConnect_x64_7_6_7_3.deb ;; \
          *) echo "unexpected version $ver" >&2; false ;; \
        esac && \
        dpkg -x "${ec_deb}" ec && \
        cp -r ec/usr/share/sangfor/EasyConnect/resources/conf \
                /usr/share/sangfor/EasyConnect/resources/conf_$ver && \
        rm -rf ec ; } || exit 1 ; done && \
    rm -rf /tmp/work /tmp/local-deps

RUN for i in /usr/share/sangfor/EasyConnect/resources/conf_*/; do \
        ln -s /root/.easyconn $i/.easyconn ; \
    done && touch /root/.easyconn

COPY ./docker-root /

COPY --from=hagb/docker-easyconnect:build /results/fake-hwaddr/ /results/tinyproxy-ws/ /

ENV PING_INTERVAL=1800

VOLUME /root/ /usr/share/sangfor/EasyConnect/resources/logs/

CMD ["start.sh"]
