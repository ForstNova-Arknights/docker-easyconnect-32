# Dockerfile.cli-armhf -- armhf (linux/arm/v7) build of the docker-easyconnect
# CLI image.
#
# Build with:
#   docker buildx build --platform linux/arm/v7 -f Dockerfile.cli-armhf \
#       -t hagb/docker-easyconnect:cli-armhf .
#
# Differences from the upstream Dockerfile.cli:
#   * The EasyConnect binaries (EC_HOST, amd64) are executed by a *patched*
#     static qemu-user built for this architecture.  The patch makes linux-user
#     forward getsockopt(fd, SOL_IP, SO_ORIGINAL_DST, ...) to the host kernel,
#     which the unpatched emulator answers with -ENOPROTOOPT.
#   * Debian's qemu-user package is deliberately *not* installed: since QEMU 10
#     it no longer ships 64-bit target emulators for 32-bit hosts, so armhf has
#     no qemu-x86_64 any more, and pulling the trixie build in would drag
#     trixie's libc into a bookworm image.
#   * Only bookworm is used as an apt source, and the EasyConnect payloads are
#     taken from ./local-deps (fetched once on the build host) so the emulated
#     build does not depend on flaky downloads.
#
# The emulator is not tied to armhf: QEMU_HOST_ARCH/QEMU_TARGET_ARCH select any
# host/target pair that qemu-user/build.sh can produce, and EC_HOST must be the
# Debian name of the architecture the EasyConnect binaries were built for.
#
#   docker buildx build --platform linux/arm/v7 -f Dockerfile.cli-armhf \
#       --build-arg QEMU_HOST_ARCH=armhf --build-arg QEMU_TARGET_ARCH=x86_64 \
#       --build-arg EC_HOST=amd64 -t docker-easyconnect:cli-armhf .

# =============================================================================
# Stage "payload" -- unpack the EasyConnect deb packages.
#
# This stage exists purely to keep the ~140 MB of deb packages out of the final
# image.  COPYing them into the image and deleting them in a later RUN does not
# help: the layer holding them stays in the image, which used to cost 137 MB.
#
# It is pinned to $BUILDPLATFORM so dpkg runs natively rather than under
# emulation -- the packages are amd64 and unpacking is architecture independent.
# =============================================================================
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS payload

COPY ["./local-deps/", "/tmp/local-deps/"]

RUN set -eux; \
    ec_dir=/usr/share/sangfor/EasyConnect/resources; \
    mkdir -p "/out${ec_dir}/bin" "/out${ec_dir}/lib64" \
             "/out${ec_dir}/shell" "/out${ec_dir}/logs"; \
    mkdir -p /tmp/work; cd /tmp/work; \
    dpkg -x /tmp/local-deps/easyconn_7.6.8.2-ubuntu_amd64.deb easyconn; \
    cp "easyconn${ec_dir}/bin/CSClient" \
       "easyconn${ec_dir}/bin/easyconn" \
       "easyconn${ec_dir}/bin/ECAgent" \
       "easyconn${ec_dir}/bin/svpnservice" \
       "easyconn${ec_dir}/bin/ca.crt" \
       "easyconn${ec_dir}/bin/cert.crt" \
       "/out${ec_dir}/bin/"; \
    cp "easyconn${ec_dir}/lib64/libnspr4.so" \
       "easyconn${ec_dir}/lib64/libnss3.so" \
       "easyconn${ec_dir}/lib64/libnssutil3.so" \
       "easyconn${ec_dir}/lib64/libplc4.so" \
       "easyconn${ec_dir}/lib64/libplds4.so" \
       "easyconn${ec_dir}/lib64/libsmime3.so" \
       "/out${ec_dir}/lib64/"; \
    cp "easyconn${ec_dir}/shell/"* "/out${ec_dir}/shell/"; \
    chmod +x "/out${ec_dir}/shell/"*; \
    cp -r "easyconn${ec_dir}/conf" "/out${ec_dir}/conf_7.6.8"; \
    rm -rf easyconn; \
    for ver in 7.6.3 7.6.7; do \
        case "$ver" in \
            7.6.3) ec_deb=/tmp/local-deps/EasyConnect_x64.deb ;; \
            7.6.7) ec_deb=/tmp/local-deps/EasyConnect_x64_7_6_7_3.deb ;; \
        esac; \
        dpkg -x "$ec_deb" ec; \
        cp -r "ec${ec_dir}/conf" "/out${ec_dir}/conf_${ver}"; \
        rm -rf ec; \
    done; \
    chmod +xs "/out${ec_dir}/bin/CSClient" \
              "/out${ec_dir}/bin/ECAgent" \
              "/out${ec_dir}/bin/svpnservice"

# =============================================================================
# Stage "emulator" -- pick the prebuilt qemu-user binary for this architecture.
#
# qemu-user/qemu-<TARGET>-<HOST> is a static qemu-user built from QEMU 9.2.3
# with qemu-user/build.sh.  The emulator is installed as /usr/bin/qemu-<TARGET>
# because that is the name build-scripts/get-echost-names.sh derives from
# EC_HOST for the wrapper it generates.
# =============================================================================
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS emulator

ARG QEMU_HOST_ARCH=armhf
ARG QEMU_TARGET_ARCH=x86_64

COPY ./qemu-user/ /qemu-user/

RUN set -eux; \
    src="/qemu-user/qemu-${QEMU_TARGET_ARCH}-${QEMU_HOST_ARCH}"; \
    if [ ! -f "$src" ]; then \
        echo "error: no prebuilt emulator at qemu-user/qemu-${QEMU_TARGET_ARCH}-${QEMU_HOST_ARCH}" >&2; \
        echo "       build one with: ./qemu-user/build.sh ${QEMU_HOST_ARCH} ${QEMU_TARGET_ARCH}" >&2; \
        exit 1; \
    fi; \
    mkdir -p /out; \
    cp "$src" "/out/qemu-${QEMU_TARGET_ARCH}"; \
    chmod 0755 "/out/qemu-${QEMU_TARGET_ARCH}"

# =============================================================================
# The image itself.
# =============================================================================
FROM debian:bookworm-slim

# Plain http on purpose: debian:bookworm-slim carries no CA certificates yet,
# so an https apt source cannot be verified until ca-certificates is installed.
ARG BUILD_ENV=local \
    MIRROR_URL=http://mirrors.aliyun.com/debian/ \
    SECURITY_URL=http://mirrors.aliyun.com/debian-security/ \
    EC_HOST=amd64 \
    QEMU_HOST_ARCH=armhf \
    QEMU_TARGET_ARCH=x86_64 \
    http_proxy https_proxy

COPY ["./build-scripts/get-echost-names.sh", "./build-scripts/mk-qemu-wrapper.sh", \
      "/tmp/build-scripts/"]

# Patched qemu-user: static, built for ${QEMU_HOST_ARCH}, emulating ${QEMU_TARGET_ARCH}.
COPY --from=emulator /out/ /usr/bin/

RUN rm -f /etc/apt/sources.list && rm -rf /etc/apt/sources.list.d/* && \
    printf 'deb %s bookworm main\ndeb %s bookworm-updates main\ndeb %s bookworm-security main\n' \
        "${MIRROR_URL}" "${MIRROR_URL}" "${SECURITY_URL}" > /etc/apt/sources.list && \
    dpkg --add-architecture "${EC_HOST}" && \
    apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests iptables \
        dante-server busybox iproute2 tinyproxy-bin ca-certificates \
        "libc6:${EC_HOST}" "libstdc++6:${EC_HOST}" socat wget && \
    for command in ps kill killall; do ln -s "$(which busybox)" /usr/local/bin/"${command}" || exit 1 ; done && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r socks && useradd -r -g socks socks

# The EasyConnect payload, unpacked in the "payload" stage.
COPY --from=payload /out/ /

RUN set -eux; \
    ec_dir=/usr/share/sangfor/EasyConnect/resources; \
    chmod +xs "${ec_dir}/bin/CSClient" "${ec_dir}/bin/ECAgent" "${ec_dir}/bin/svpnservice"; \
    extra_bins=easyconn . /tmp/build-scripts/mk-qemu-wrapper.sh; \
    ln -s "${ec_dir}/bin/easyconn" /usr/local/bin/; \
    echo "EC_CLI" > /etc/vpn-type

RUN for i in /usr/share/sangfor/EasyConnect/resources/conf_*/; do \
        ln -s /root/.easyconn $i/.easyconn ; \
    done && touch /root/.easyconn

COPY ./docker-root /

COPY --from=hagb/docker-easyconnect:build /results/fake-hwaddr/ /results/tinyproxy-ws/ /

ENV PING_INTERVAL=1800

VOLUME /root/ /usr/share/sangfor/EasyConnect/resources/logs/

CMD ["start.sh"]
